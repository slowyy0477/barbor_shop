# Copy this file to .env and replace every placeholder before deployment.
# Never commit .env, provider tokens, database passwords or signing keys.
POSTGRES_DB=ayan_salon
POSTGRES_USER=ayan
POSTGRES_PASSWORD=replace-with-a-long-random-password
CADDY_SITE=salon.example.com
AYAN_WEB_ALLOWED_ORIGINS=https://salon.example.com
AYAN_AUTH_SESSION_SECRET=replace-with-at-least-32-random-bytes
AYAN_AUTH_SESSION_LIFETIME=PT12H
AYAN_AUTH_OWNER_PHONE=
AYAN_AUTH_OWNER_SALON_ID=00000000-0000-0000-0000-000000000001
AYAN_AUTH_OWNER_PIN=
AYAN_AUTH_OTP_PROVIDER_URL=
AYAN_AUTH_OTP_PROVIDER_TOKEN=
AYAN_AUTH_OTP_SENDER=Ayan Salon
AYAN_NOTIFICATION_PROVIDER_URL=
AYAN_NOTIFICATION_PROVIDER_TOKEN=
AYAN_RATE_LIMIT_ENABLED=true
AYAN_RATE_LIMIT_GENERAL_PER_MINUTE=120
AYAN_RATE_LIMIT_OTP_PER_MINUTE=5
AYAN_RATE_LIMIT_AUTH_PER_MINUTE=20
AYAN_RATE_LIMIT_ADMIN_PER_MINUTE=60
