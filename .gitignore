# Local browser/runtime state
tmp/
node_modules/
.env
.env.*
!.env.example

# Android/Gradle outputs and local SDK metadata
android/.gradle/
android/build/
android/app/build/
android/local.properties
.android-sdk/
.gradle-user/
.gradle/
.m2/
*.keystore
*.jks
android/keys/
android/release-signing.properties

# IDE files
.idea/
*.iml
.vscode/

# Private files on the owner's own machine: passwords, tokens and saved state.
# They are never committed and never shared.
ops/*.local.json
ops/*.local.json.bak
ops/*.local.txt
ops/*.state.json
ops/salon-sign-in-codes.log

# Build output created only when the owner runs the Java server on this machine.
server/target/
server/.tmp/
server/build.log
server/build.err

# The web app is copied into the server by ops/sync-server-web.ps1.
server/src/main/resources/static/

# OS files
Thumbs.db
Desktop.ini
tmp/
*.log
